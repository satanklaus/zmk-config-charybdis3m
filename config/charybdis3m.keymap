#include <behaviors.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/buzzer.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        /* Pushbutton on the dongle's P1.15 (zmk-behavior-pushbutton module).
         * Kept here, not in the keyboard shield, so a stock build has no
         * pushbutton. Okay on every board so &pb resolves in the keymap; the
         * module builds the driver only on the central, so the halves never
         * drive the pin (P1.15 is a matrix pin there). */
        kvm1: pushbutton1 {
            compatible = "zmk,behavior-pushbutton";
            display-name = "Push Button KVM1";
            #binding-cells = <0>;
            gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
            press-duration-ms = <200>;
            status = "okay";
        };
        kvm2: pushbutton2 {
            compatible = "zmk,behavior-pushbutton";
            display-name = "Push Button KVM2";
            #binding-cells = <0>;
            gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
            press-duration-ms = <200>;
            status = "okay";
        };
        kvm3: pushbutton3 {
            compatible = "zmk,behavior-pushbutton";
            display-name = "Push Button KVM3";
            #binding-cells = <0>;
            gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
            press-duration-ms = <200>;
            status = "okay";
        };
        kvm4: pushbutton4 {
            compatible = "zmk,behavior-pushbutton";
            display-name = "Push Button KVM4";
            #binding-cells = <0>;
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
            press-duration-ms = <500>;
            status = "okay";
        };

        /* Vibration on the dongle (zmk-feedback-haptic module); the
         * parameter is the pattern number in &haptic below. */
        hap: haptic {
            compatible = "zmk,behavior-haptic";
            display-name = "Haptic";
            #binding-cells = <1>;
            motor = <&haptic>;
        };

        /* Sound on the dongle (zmk-feedback-buzzer module); the parameter
         * is the melody number in &buzzer below. */
        beep: buzzer {
            compatible = "zmk,behavior-buzzer";
            display-name = "Buzzer";
            #binding-cells = <1>;
            buzzer = <&buzzer>;
        };
    };

    /* Passive buzzer on the dongle's P0.02 (D19), PWM0 is routed there in
     * charybdis3m_central.overlay. The halves never enable PWM0 or build the
     * driver. Melodies are frequency/ms pairs, numbered from 0 in this order. */
    buzzer: buzzer {
        compatible = "zmk,buzzer";
        pwms = <&pwm0 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;

        beep { notes = <NOTE_A6 60>; };
        startup: startup { notes = <NOTE_C6 70 NOTE_E6 70 NOTE_G6 70 NOTE_C7 140>; };
        usb_up: usb_up { notes = <NOTE_G6 60 NOTE_C7 90>; };
        usb_down: usb_down { notes = <NOTE_C7 60 NOTE_G6 90>; };
        service_on: service_on { notes = <NOTE_E7 40 NOTE_REST 30 NOTE_E7 40>; };
        service_off: service_off { notes = <NOTE_E6 80>; };
    };

    buzzer_triggers {
        compatible = "zmk,buzzer-triggers";
        startup = <&startup>;
        usb-connected = <&usb_up>;
        usb-disconnected = <&usb_down>;

        service {
            layer = <7>;
            on = <&service_on>;
            off = <&service_off>;
        };
    };

    /* Vibration motor on the dongle's P0.09 (D10) through a MOSFET. Like the
     * pushbuttons, the driver is only built on the central. Patterns are
     * on/off ms, numbered from 0 in this order. */
    haptic: haptic {
        compatible = "zmk,haptic-motor";
        gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;

        one { timings-ms = <60>; };
        two { timings-ms = <60 80 60>; };
        three { timings-ms = <60 80 60 80 60>; };
        long { timings-ms = <300>; };
    };

    macros {
        /* KVM switch plus a buzz per target: 1, 2, 3 buzzes, long for KVM4 */
        kvm1_hap: kvm1_hap {
            compatible = "zmk,behavior-macro";
            display-name = "KVM1 + buzz";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kvm1 &hap 0>;
        };
        kvm2_hap: kvm2_hap {
            compatible = "zmk,behavior-macro";
            display-name = "KVM2 + buzz";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kvm2 &hap 1>;
        };
        kvm3_hap: kvm3_hap {
            compatible = "zmk,behavior-macro";
            display-name = "KVM3 + buzz";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kvm3 &hap 2>;
        };
        kvm4_hap: kvm4_hap {
            compatible = "zmk,behavior-macro";
            display-name = "KVM4 + buzz";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kvm4 &hap 3>;
        };
    };
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    behaviors {
        multi_backspace: multi_backspace {
            compatible = "zmk,behavior-tap-dance";
            label = "MULTI_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&to 5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        three_fingers {
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <32 33 34>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "main";
            bindings = <
&kp ESC         &kp N1              &kp N2          &kp N3            &kp N4     &kp N5           &kp N6         &kp N7     &kp N8            &kp N9          &kp N0                      &kp MINUS
&kp TAB         &kp Q               &kp W           &kp E             &kp R      &kp T            &kp Y          &kp U      &kp I             &kp O           &kp P                       &kp BSLH
&kp LEFT_WIN    &mt LEFT_CONTROL A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &lt 4 F    &lt 1 G          &lt 1 H        &lt 4 J    &mt LEFT_SHIFT K  &mt LEFT_ALT L  &mt LEFT_CONTROL SEMICOLON  &mt LEFT_WIN SQT
&kp LEFT_SHIFT  &kp Z               &kp X           &kp C             &kp V      &lt 2 B          &kp N          &kp M      &kp COMMA         &kp DOT         &kp FSLH                    &kp RIGHT_SHIFT
                                                    &kp LEFT_WIN      &kp SPACE  &kp BACKSPACE    &kp ENTER      &kp SPACE
                                                                      &mo 3      &to 7            &kp BACKSPACE
            >;
        };

        Fn_Mouse {
            display-name = "Fn_Mouse";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5    &kp F6          &kp F7          &kp F8     &kp F9     &kp F10  &kp PRINTSCREEN
&trans  &kp F11  &kp F12  &trans  &trans  &trans    &kp LC(INSERT)  &kp LS(INSERT)  &trans     &trans     &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans    &trans          &mkp LCLK       &mkp RCLK  &mkp MCLK  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans    &trans          &trans          &trans     &trans     &trans   &trans
                          &trans  &trans  &trans    &trans          &trans
                                  &trans  &trans    &trans
            >;
        };

        BT_layers {
            display-name = "BT_layers";
            bindings = <
&kp NUMBER_2  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans        &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans        &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans        &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                            &trans        &trans        &trans          &trans      &trans
                                                          &trans        &trans          &trans
            >;
        };

        movements {
            display-name = "movements";
            bindings = <
&kp NUMBER_3  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans         &trans           &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans    &kp HOME        &kp PAGE_UP     &kp PAGE_DOWN  &kp END          &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans         &trans           &trans  &trans
                              &trans  &trans  &trans    &trans          &trans
                                      &trans  &trans    &trans
            >;
        };

        supplements {
            display-name = "supplements";
            bindings = <
&kp TILDE  &trans  &trans  &trans  &trans  &trans       &kp PRINTSCREEN  &kp LEFT_BRACE     &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL
&trans     &trans  &trans  &trans  &trans  &kp GRAVE    &kp LC(INSERT)   &kp LS(INSERT)     &kp LA(INSERT)   &trans            &trans             &kp LS(EQUAL)
&trans     &trans  &trans  &trans  &trans  &trans       &trans           &mkp LCLK          &mkp RCLK        &mkp MCLK         &trans             &kp GRAVE
&trans     &trans  &trans  &trans  &trans  &trans       &trans           &kp RIGHT_BRACKET  &trans           &trans            &trans             &trans
                           &trans  &trans  &trans       &trans           &trans
                                   &trans  &trans       &trans
            >;
        };

        LAZY {
            display-name = "LAZY";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &mkp LCLK  &mkp RCLK  &mo 6   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans     &trans     &trans  &trans  &trans
                        &trans  &trans  &trans    &kp LEFT_ARROW  &kp RIGHT
                                &trans  &trans    &to 0
            >;
        };

        scrolly {
            display-name = "scrolly";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        Service {
            display-name = "Service";
            bindings = <
&kvm1_hap  &kvm2_hap  &kvm3_hap  &kvm4_hap  &studio_unlock  &none    &to 0  &to 8  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none
                            &none  &none    &none
            >;
        };

        pure_typin {
            display-name = "pure_typin";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3        &kp N4     &kp N5           &kp N6         &kp N7     &kp N8     &kp N9   &kp N0         &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E         &kp R      &kp T            &kp Y          &kp U      &kp I      &kp O    &kp P          &kp BSLH
&kp LEFT_WIN    &kp A   &kp S   &kp D         &kp F      &kp G            &kp H          &kp J      &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C         &kp V      &kp B            &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                &kp LEFT_WIN  &kp SPACE  &kp BACKSPACE    &kp ENTER      &kp SPACE
                                              &mo 3      &to 7            &kp BACKSPACE
            >;
        };
    };
};
